{
  "name": "rb-e2e-framework",
  "version": "1.0.0",
  "description": "Framework de tests E2E Playwright + TypeScript (POM, BDD/Gherkin, reportingLabs, multi-environnements)",
  "scripts": {
    "bdd:gen": "bddgen",
    "pretest": "npm run bdd:gen",
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev npm test --",
    "test:staging": "cross-env TEST_ENV=staging npm test --",
    "test:prod": "cross-env TEST_ENV=prod npm test --",
    "test:smoke": "npm test -- --grep @smoke",
    "test:regression": "npm test -- --grep @regression",
    "test:functional": "npm test -- --grep @functional",
    "test:navigation": "npm test -- --grep @navigation",
    "test:forms": "npm test -- --grep @forms",
    "test:a11y": "npm test -- --grep @a11y",
    "test:seo": "npm test -- --grep @seo",
    "test:links": "npm test -- --grep @links",
    "test:api": "npm test -- --project=api",
    "test:bd": "npm test -- --project=bd",
    "test:chromium": "npm test -- --project=chromium",
    "test:firefox": "npm test -- --project=firefox",
    "test:webkit": "npm test -- --project=webkit",
    "test:mobile": "npm test -- --project=mobile-chrome --project=mobile-safari",
    "test:headed": "npm test -- --headed --project=chromium",
    "test:debug": "npm test -- --debug --project=chromium",
    "test:ui": "npm run bdd:gen && playwright test --ui",
    "report:html": "playwright show-report ../../reports/html-report",
    "report:open": "node ../config_report/scripts/open-report.mjs",
    "report:merge": "reporting-labs merge",
    "clean": "node -e \"for (const d of ['reporting-labs','html-report','test-results','junit','.features-gen'].map((d) => '../../reports/' + d)) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && eslint --config Configuration_Playwright/config_qualite/eslint.config.mjs .",
    "lint:fix": "cd ../.. && eslint --config Configuration_Playwright/config_qualite/eslint.config.mjs . --fix",
    "format": "cd ../.. && prettier --config Configuration_Playwright/config_qualite/.prettierrc.json --write \"Test_E2E/**/*.{ts,mjs,json}\" \"Configuration_Playwright/*/*.{ts,mjs,json}\" \"Configuration_Playwright/config_report/scripts/*.mjs\"",
    "format:check": "cd ../.. && prettier --config Configuration_Playwright/config_qualite/.prettierrc.json --check \"Test_E2E/**/*.{ts,mjs,json}\" \"Configuration_Playwright/*/*.{ts,mjs,json}\" \"Configuration_Playwright/config_report/scripts/*.mjs\"",
    "docker:build": "docker compose -f ../config_docker/docker-compose.yml build tests",
    "docker:test": "docker compose -f ../config_docker/docker-compose.yml run --rm tests",
    "docker:db:up": "docker compose -f ../config_docker/docker-compose.yml up -d --wait postgres mysql",
    "docker:db:down": "docker compose -f ../config_docker/docker-compose.yml down",
    "browsers:install": "playwright install --with-deps",
    "test:tablet": "npm test -- --project=tablet"
  },
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "reporting-labs": "^0.6.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
