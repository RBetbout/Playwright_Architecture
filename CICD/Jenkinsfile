// Dans la configuration du job, "Script Path" doit valoir : CICD/Jenkinsfile
//
// Prérequis Jenkins :
//  - plugin NodeJS avec une installation nommée "node-22"
//  - plugins JUnit et HTML Publisher
//  - credentials par environnement (dev, staging, prod) :
//      e2e-user-<env>       "Username with password" : compte de test de l'application
//      e2e-api-token-<env>  "Secret text"            : jeton de l'API
//      e2e-db-<env>         "Username with password" : compte de la base de données
//  - variables non secrètes (API_URL, DB_ENGINE, DB_HOST, DB_PORT, DB_NAME) : configuration du job ou fichier .env
//  - pour DOCKER=true : Docker et Docker Compose sur l'agent
pipeline {
  agent any

  tools { nodejs 'node-22' }

  parameters {
    choice(name: 'TEST_ENV', choices: ['dev', 'staging', 'prod'], description: 'Environnement cible')
    choice(name: 'SUITE', choices: ['smoke', 'regression', 'functional', 'navigation', 'forms', 'a11y', 'seo', 'links', 'all'], description: 'Suite à exécuter')
    // Seuls les navigateurs activés dans Configuration_Playwright/config_playwright/playwright.config.ts (BROWSERS) sont disponibles.
    choice(name: 'BROWSER', choices: ['chromium', 'api', 'bd', 'all'], description: 'Projet Playwright')
    booleanParam(name: 'DOCKER', defaultValue: false, description: "Exécuter les tests dans le conteneur du projet (pas d'installation sur l'agent)")
    string(name: 'BASE_URL', defaultValue: '', description: "URL cible (laisser vide si elle est définie dans la configuration du job)")
  }

  options {
    timeout(time: 60, unit: 'MINUTES')
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    CI = 'true'
    TEST_ENV = "${params.TEST_ENV}"
  }

  stages {
    // package.json et la configuration de l'outillage sont dans Configuration_Playwright/config_playwright/ : toutes les commandes npm s'y exécutent.
    stage('Installation') {
      when { expression { !params.DOCKER } }
      steps {
        dir('Configuration_Playwright/config_playwright') {
          sh 'npm ci'
          sh 'npx playwright install --with-deps'
        }
      }
    }

    stage('Qualité du code') {
      when { expression { !params.DOCKER } }
      steps {
        dir('Configuration_Playwright/config_playwright') {
          sh 'npm run typecheck'
          sh 'npm run lint'
          sh 'npm run format:check'
        }
      }
    }

    stage('Tests E2E') {
      steps {
        script {
          def grep = params.SUITE == 'all' ? '' : "--grep @${params.SUITE}"
          def project = params.BROWSER == 'all' ? '' : "--project=${params.BROWSER}"
          def overrides = params.BASE_URL?.trim() ? ["BASE_URL=${params.BASE_URL.trim()}"] : []

          withEnv(overrides) {
            withCredentials([
              usernamePassword(
                credentialsId: "e2e-user-${params.TEST_ENV}",
                usernameVariable: 'USER_EMAIL',
                passwordVariable: 'USER_PASSWORD'
              ),
              string(credentialsId: "e2e-api-token-${params.TEST_ENV}", variable: 'API_TOKEN'),
              usernamePassword(
                credentialsId: "e2e-db-${params.TEST_ENV}",
                usernameVariable: 'DB_USER',
                passwordVariable: 'DB_PASSWORD'
              )
            ]) {
              dir('Configuration_Playwright/config_playwright') {
                if (params.DOCKER) {
                  // Le conteneur reçoit les variables d'environnement du job (voir docker-compose.yml).
                  sh 'npm run docker:build'
                  sh "npm run docker:test -- ${grep} ${project}"
                } else {
                  sh "npm test -- ${grep} ${project}"
                }
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit/results.xml'
      // Screenshots, vidéos et traces des tests en échec sont dans reports/test-results.
      archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/test-results/**, reports/reporting-labs/**, reports/html-report/**'
      // Jenkins bloque par défaut le JavaScript des rapports publiés (CSP) : sans assouplissement
      // par un administrateur, télécharger reports/reporting-labs depuis les artefacts et ouvrir index.html.
      publishHTML(target: [
        reportName: 'reportingLabs',
        reportDir: 'reports/reporting-labs',
        reportFiles: 'index.html',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      publishHTML(target: [
        reportName: 'Playwright Report',
        reportDir: 'reports/html-report',
        reportFiles: 'index.html',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
    }
  }
}
