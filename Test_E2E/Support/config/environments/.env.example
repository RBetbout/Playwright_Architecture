# Modèle de configuration d'environnement.
# Copier vers .env.dev / .env.staging / .env.prod (fichiers ignorés par Git).
# En CI, ces variables sont injectées par Jenkins (credentials) et priment sur le fichier.

# --- Cible ---
BASE_URL=https://playwright.dev
API_URL=https://api.dev.example.com
# Jeton envoyé en "Authorization: Bearer" ; laisser vide si l'API est publique.
API_TOKEN=

# --- Base de données : postgresql | mysql (laisser DB_ENGINE vide si aucun test de base) ---
# Avec les services Docker du projet (npm run docker:db:up) : hôte localhost, base/utilisateur/mot de passe "e2e".
DB_ENGINE=
DB_HOST=localhost
# Par défaut : 5432 pour postgresql, 3306 pour mysql.
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Identifiants (ne jamais committer de vraies valeurs) ---
USER_EMAIL=
USER_PASSWORD=

# --- Timeouts (ms) ---
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# --- Navigateur ---
HEADLESS=true
SLOW_MO=0

# --- Logs : debug | info | warn | error ---
LOG_LEVEL=info
