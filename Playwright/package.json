{
  "name": "rb-e2e-framework",
  "version": "1.0.0",
  "description": "Framework de tests E2E Playwright + TypeScript (POM, BDD/Gherkin, reportingLabs, multi-environnements)",
  "scripts": {
    "bdd:gen": "bddgen",
    "pretest": "npm run bdd:gen",
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev npm test --",
    "test:staging": "cross-env TEST_ENV=staging npm test --",
    "test:prod": "cross-env TEST_ENV=prod npm test --",
    "test:smoke": "npm test -- --grep @smoke",
    "test:regression": "npm test -- --grep @regression",
    "test:functional": "npm test -- --grep @functional",
    "test:navigation": "npm test -- --grep @navigation",
    "test:forms": "npm test -- --grep @forms",
    "test:a11y": "npm test -- --grep @a11y",
    "test:seo": "npm test -- --grep @seo",
    "test:links": "npm test -- --grep @links",
    "test:bdd": "npm test -- --grep @bdd",
    "test:chromium": "npm test -- --project=chromium --project=chromium-bdd",
    "test:firefox": "npm test -- --project=firefox --project=firefox-bdd",
    "test:webkit": "npm test -- --project=webkit --project=webkit-bdd",
    "test:mobile": "npm test -- --project=mobile-chrome --project=mobile-chrome-bdd --project=mobile-safari --project=mobile-safari-bdd",
    "test:headed": "npm test -- --headed --project=chromium --project=chromium-bdd",
    "test:debug": "npm test -- --debug --project=chromium --project=chromium-bdd",
    "test:ui": "npm run bdd:gen && playwright test --ui",
    "report:html": "playwright show-report ../reports/html-report",
    "report:open": "node ../Projet/scripts/open-report.mjs",
    "report:merge": "reporting-labs merge",
    "clean": "node -e \"for (const d of ['../reports/reporting-labs','../reports/html-report','../reports/test-results','../reports/junit','.features-gen']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint --config Playwright/eslint.config.mjs .",
    "lint:fix": "cd .. && eslint --config Playwright/eslint.config.mjs . --fix",
    "format": "cd .. && prettier --config Playwright/.prettierrc.json --write \"Projet/**/*.{ts,mjs,json}\" \"Playwright/*.{ts,mjs}\" Playwright/package.json Playwright/tsconfig.json",
    "format:check": "cd .. && prettier --config Playwright/.prettierrc.json --check \"Projet/**/*.{ts,mjs,json}\" \"Playwright/*.{ts,mjs}\" Playwright/package.json Playwright/tsconfig.json",
    "browsers:install": "playwright install --with-deps",
    "test:tablet": "npm test -- --project=tablet --project=tablet-bdd"
  },
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "reporting-labs": "^0.6.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
