{
  "name": "rb-projet",
  "private": true,
  "description": "Relais : transmet les commandes npm au vrai package.json, dans Playwright/",
  "scripts": {
    "test": "npm --prefix Playwright test --",
    "test:dev": "npm --prefix Playwright run test:dev --",
    "test:staging": "npm --prefix Playwright run test:staging --",
    "test:prod": "npm --prefix Playwright run test:prod --",
    "test:smoke": "npm --prefix Playwright run test:smoke --",
    "test:regression": "npm --prefix Playwright run test:regression --",
    "test:functional": "npm --prefix Playwright run test:functional --",
    "test:navigation": "npm --prefix Playwright run test:navigation --",
    "test:forms": "npm --prefix Playwright run test:forms --",
    "test:a11y": "npm --prefix Playwright run test:a11y --",
    "test:seo": "npm --prefix Playwright run test:seo --",
    "test:links": "npm --prefix Playwright run test:links --",
    "test:bdd": "npm --prefix Playwright run test:bdd --",
    "test:chromium": "npm --prefix Playwright run test:chromium --",
    "test:firefox": "npm --prefix Playwright run test:firefox --",
    "test:webkit": "npm --prefix Playwright run test:webkit --",
    "test:mobile": "npm --prefix Playwright run test:mobile --",
    "test:headed": "npm --prefix Playwright run test:headed --",
